From: Custom Engine Patch <dev@local>
Subject: [PATCH] search: restore Google as default prepopulated search engine

Set Google as the first-choice engine in the fallback list and bump
kCurrentDataVersion so existing local profiles and Android databases
refresh to Google rather than DuckDuckGo or other defaults.
---
 components/search_engines/template_url_prepopulate_data.cc | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/components/search_engines/template_url_prepopulate_data.cc b/components/search_engines/template_url_prepopulate_data.cc
index 8e482ab..7bc549f 100644
--- a/components/search_engines/template_url_prepopulate_data.cc
+++ b/components/search_engines/template_url_prepopulate_data.cc
@@ -47,7 +47,7 @@ namespace {
 // If you change the engine lists, you must increment this value. This will
 // cause existing users with unmodified default search providers to get the new
 // list.
-const int kCurrentDataVersion = 180;
+const int kCurrentDataVersion = 181;
 
 // Default search engines list for countries without country-specific list.
 const PrepopulatedEngine* const engines_default[] = {
+    &google,
     &duckduckgo,
-    &google,
     &bing,
     &yahoo,
 };
@@ -128,11 +128,11 @@ int GetDataVersion(PrefService* prefs) {
 
 const PrepopulatedEngine* GetDefaultPrepopulatedEngine(
     const std::vector<const PrepopulatedEngine*>& engines) {
-  for (const auto* engine : engines) {
-    if (engine->type == SEARCH_ENGINE_DUCKDUCKGO) {
-      return engine;
-    }
-  }
+  for (const auto* engine : engines) {
+    if (engine->type == SEARCH_ENGINE_GOOGLE) {
+      return engine;
+    }
+  }
   return engines.empty() ? nullptr : engines[0];
 }
 
